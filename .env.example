# Copy to `.env` (gitignored) and fill in. Loaded via `uv run --env-file .env ...`
# or supplied by docker-compose. See README for setup.

# --- OANDA credentials (required) ---
# Get from the OANDA web app: Manage API Access -> Generate. A free practice
# account is fine for development.
OANDA_API_TOKEN=your-token-here
OANDA_ACCOUNT_ID=XXX-XXX-XXXXXXXX-XXX

# practice (default) or live. Use live only with a funded account.
OANDA_ENV=practice

# --- Optional overrides (defaults shown) ---
# FX_PULSE_PROVIDER=oanda
# LOG_LEVEL=INFO
# FX_PULSE_MODEL_DIR=data/models

# Required when running outside docker-compose (compose sets this for you).
# DATABASE_URL=postgresql://fx_pulse:fx_pulse@localhost:5432/fx_pulse
